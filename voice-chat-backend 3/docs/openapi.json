{
  "openapi": "3.1.0",
  "info": {
    "title": "网页智能语音对话后端",
    "description": "Bearer登录；语音识别和朗读默认由浏览器完成。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/speech/transcriptions": {
      "post": {
        "tags": [
          "speech-controller"
        ],
        "summary": "上传音频并转写；未配置语音服务时返回501",
        "operationId": "transcribe",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "zh-CN",
              "maxLength": 35,
              "minLength": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Transcription"
                }
              }
            }
          }
        }
      }
    },
    "/api/speech/synthesis": {
      "post": {
        "tags": [
          "speech-controller"
        ],
        "summary": "合成朗读音频；未配置语音服务时返回501",
        "operationId": "synthesize",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SynthesisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations": {
      "get": {
        "tags": [
          "conversation-controller"
        ],
        "summary": "按更新时间倒序分页查询会话",
        "operationId": "list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "maximum": 1000000,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageViewConversationView"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "conversation-controller"
        ],
        "summary": "创建当前用户的独立会话",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationView"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{id}/messages": {
      "get": {
        "tags": [
          "conversation-controller"
        ],
        "summary": "按消息顺序正序分页查询历史",
        "operationId": "history",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "maximum": 1000000,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageViewMessageView"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "conversation-controller"
        ],
        "summary": "发送文字或语音识别后的文字，返回回答和可选追问",
        "operationId": "send",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "注册：用户名大小写不敏感；密码8至64字符且UTF-8不超过72字节",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "使当前登录凭证立即失效",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "登录并获得24小时有效的Bearer Token",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "speech-controller"
        ],
        "summary": "服务存活检查，不调用外部模型",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/capabilities": {
      "get": {
        "tags": [
          "speech-controller"
        ],
        "summary": "查询浏览器和后端语音能力",
        "operationId": "capabilities",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/conversations/{id}": {
      "delete": {
        "tags": [
          "conversation-controller"
        ],
        "summary": "删除会话及全部消息",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Transcription": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          }
        }
      },
      "SynthesisRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 0
          },
          "voice": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "speed": {
            "type": "number",
            "format": "double",
            "maximum": 2.0,
            "minimum": 0.5
          }
        },
        "required": [
          "text"
        ]
      },
      "CreateConversation": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        }
      },
      "ConversationView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SendMessage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 0
          },
          "inputSource": {
            "type": "string",
            "pattern": "text|speech"
          }
        },
        "required": [
          "content"
        ]
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "userMessageId": {
            "type": "integer",
            "format": "int64"
          },
          "assistantMessageId": {
            "type": "integer",
            "format": "int64"
          },
          "reply": {
            "type": "string"
          },
          "followUp": {
            "type": "string"
          },
          "speakText": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_]{3,32}"
          },
          "password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "UserView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          }
        }
      },
      "PageViewConversationView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationView"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MessageView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "followUp": {
            "type": "string"
          },
          "speakText": {
            "type": "string"
          },
          "inputSource": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PageViewMessageView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageView"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "recognition": {
            "$ref": "#/components/schemas/SpeechCapability"
          },
          "synthesis": {
            "$ref": "#/components/schemas/SpeechCapability"
          },
          "browserPlayback": {
            "$ref": "#/components/schemas/PlaybackCapability"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        }
      },
      "Limits": {
        "type": "object",
        "properties": {
          "maxInputCharacters": {
            "type": "integer",
            "format": "int32"
          },
          "maxAudioBytes": {
            "type": "integer",
            "format": "int64"
          },
          "acceptedAudioTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PlaybackCapability": {
        "type": "object",
        "properties": {
          "pause": {
            "type": "boolean"
          },
          "resume": {
            "type": "boolean"
          },
          "stop": {
            "type": "boolean"
          }
        }
      },
      "SpeechCapability": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "backendAvailable": {
            "type": "boolean"
          },
          "provider": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}